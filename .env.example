# Free-UnsecuredApis-Finder Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_DB=UnsecuredAPIKeys
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Connection string for Entity Framework (used by WebAPI, Scraper, Verifier)
# Format: Host=localhost;Port=5432;Database=UnsecuredAPIKeys;Username=postgres;Password=your_password
CONNECTION_STRING=Host=localhost;Port=5432;Database=UnsecuredAPIKeys;Username=postgres;Password=your_secure_password_here

# =============================================================================
# GitHub / GitLab / Sourcegraph API Tokens (for Scraper)
# =============================================================================
# Single token (legacy)
GITHUB_TOKEN=ghp_your_github_personal_access_token
# Multiple tokens for rotation (comma-separated)
GITHUB_TOKENS=ghp_token1,ghp_token2,ghp_token3
GITLAB_TOKEN=glpat_your_gitlab_token
SOURCEGRAPH_TOKEN=sgp_your_sourcegraph_token

# =============================================================================
# WebAPI Configuration
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
PRODUCTION_DOMAIN=free-unsecured-apis.vercel.app

# Service names for status monitoring
SCRAPER_SERVICE_NAME=api-scraper
VERIFIER_SERVICE_NAME=api-verifier

# =============================================================================
# Frontend (Next.js UI) - Prefix with NEXT_PUBLIC_ for client-side access
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:7227
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.0
NEXT_PUBLIC_GA_MEASUREMENT_ID=YOUR_GA_MEASUREMENT_ID

# =============================================================================
# Discord OAuth (for enhanced features)
# =============================================================================
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# =============================================================================
# Redis (for caching, SignalR, Celery if used)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Sentry (Error tracking - optional)
# =============================================================================
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
